---
import type { Language } from '../data/team';
import { languages } from '../data/site';

interface Props { current: Language; }
const { current } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<nav class="language-switcher" aria-label="Language">
  {languages.map((item) => (
    <a class:list={{ active: item.code === current }} href={`${base}${item.path.replace(/^\//, '')}`} lang={item.code} aria-current={item.code === current ? 'page' : undefined}>
      {item.code === 'ja' ? '日本語' : item.label}
    </a>
  ))}
</nav>
