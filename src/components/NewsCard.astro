---
import type { Language } from '../data/team';
import type { NewsItem } from '../data/news';
import Arrow from './Arrow.astro';

interface Props { item: NewsItem; language: Language; readMore: string; source: string; }
const { item, language, readMore, source } = Astro.props;
const base = import.meta.env.BASE_URL;
const image = item.image ? `${base}${item.image.replace(/^\//, '')}` : undefined;
---
<article class="news-card">
  {item.image && <a class="news-card-image" href={item.url} target="_blank" rel="noreferrer" aria-label={`${readMore}: ${item.title[language]}`}>
    <img src={image} alt={item.imageAlt[language]} loading="lazy" decoding="async" width="720" height="420" />
  </a>}
  <div class="news-card-body">
    <div class="news-card-meta"><time datetime={item.date}>{item.dateLabel[language]}</time><span aria-hidden="true">·</span><span>{source}</span></div>
    <h3><a href={item.url} target="_blank" rel="noreferrer">{item.title[language]}</a></h3>
    <p>{item.summary[language]}</p>
    <a class="text-link" href={item.url} target="_blank" rel="noreferrer" aria-label={`${readMore}: ${item.title[language]}`}>{readMore} <Arrow size={16} /></a>
  </div>
</article>
